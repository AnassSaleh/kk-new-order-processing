      "id": "7595b687-cb3f-4d2a-9057-71635c00d772",
      "name": "Sticky Note2"
    },
    {
      "parameters": {
        "content": "## 3. Stop duplicates\nLooks for the Order ID in the Orders tab.\nFound → logged in Errors as \"Duplicate\", Hana is alerted,\nthe store gets 409. The order is NOT saved twice.",
        "height": 208,
        "width": 352,
        "color": 6
      },
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
