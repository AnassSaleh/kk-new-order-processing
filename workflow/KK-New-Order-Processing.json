              "type": "string"
            },
            {
              "id": "813e58b1-283c-4a3e-9807-607fb6884347",
              "name": "Date",
              "value": "={{ (() => {\n  const d = String($('New Order Received').item.json.body.order_date ?? '').trim();\n  const zone = 'Asia/Kuala_Lumpur';\n  let dt;\n  if (/^\\d{1,2}\\/\\d{1,2}\\/\\d{4}/.test(d)) {\n    dt = DateTime.fromFormat(d.split(' ')[0], 'd/M/yyyy', { zone });\n  } else {\n    dt = DateTime.fromISO(d, { zone });\n    if (!dt.isValid) dt = DateTime.fromFormat(d, 'd LLL yyyy h:mm a', { zone, locale: 'en' });\n  }\n  return dt.isValid ? dt.toFormat('yyyy-MM-dd') : '';\n})() }}",
              "type": "string"
            },
            {
              "id": "c29a1c1b-0d7f-44b6-9625-b70e6ab13767",
              "name": "Customer Name",
              "value": "={{ (typeof $('New Order Received').item.json.body.customer_name === 'string' ? $('New Order Received').item.json.body.customer_name : '').trim().replace(/\\s+/g, ' ') }}",
              "type": "string"
            },
            {
              "id": "f35a9b96-1502-48e9-ad0e-24175039dfa3",
              "name": "Email",
              "value": "={{ String($('New Order Received').item.json.body.email ?? '').trim().toLowerCase() }}",
              "type": "string"
            },
            {
              "id": "52fbd19e-6bf3-4b32-9722-2efe45845633",
              "name": "Product",
              "value": "={{ (typeof $('New Order Received').item.json.body.product_name === 'string' ? $('New Order Received').item.json.body.product_name : '').trim().replace(/\\s+/g, ' ') }}",
              "type": "string"
            },
            {
              "id": "7a4c3393-0bb4-40ad-8f00-3e2c8d3fe6ed",
              "name": "Quantity",
              "value": "={{ $('New Order Received').item.json.body.quantity }}",
              "type": "string"
            },
            {
              "id": "cf3e9bcd-9e99-4fff-81ae-fc1344942454",
              "name": "Total",
              "value": "={{ Math.round(Number(String($('New Order Received').item.json.body.quantity ?? '').trim()) * Number(String($('New Order Received').item.json.body.price ?? '').replace(/RM/i, '').replace(/,/g, '').trim()) * 100) / 100 }}",
              "type": "number"
            },
            {
              "id": "4b924ce7-cb2b-4278-81aa-cf7aa232943d",
              "name": "Shipping Address",
              "value": "={{ String($('New Order Received').item.json.body.shipping_address ?? '').split(/\\r?\\n/).map(l => l.trim().replace(/,$/, '')).filter(l => l !== '').join(', ') }}",
              "type": "string"
            },
            {
              "id": "fef9551b-e2d7-4e08-a060-b63bd543d515",
              "name": "Status",
              "value": "New",
              "type": "string"
            }
